# Server Environment Variables
NODE_ENV=development
PORT=5000

# Client & CORS Configuration
# Supports single origin, comma-separated list, or project Vercel previews (https://shopsphere*.vercel.app)
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=https://shopsphere.vercel.app,https://shopsphere.com
APP_BASE_URL=http://localhost:5173

# Reverse Proxy / PaaS Configuration
# Number of trusted upstream hops (e.g. 1 for Render / Cloudflare load balancer)
TRUST_PROXY=1

# Database Connection
# In production: Required valid Atlas URI (mongodb+srv://...); localhost is rejected in production
MONGODB_URI=mongodb://localhost:27017/shopsphere

# Security & Authentication
# In production: Minimum 32 characters required; dev/placeholder prefixes are rejected
# Generate secure keys via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_32_character_jwt_secret_passphrase_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_32_character_cookie_secret_passphrase_here

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=shopsphere-fashion
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Admin Bootstrap Secret Key
ADMIN_BOOTSTRAP_KEY=bootstrap_secret_token_12345

# ==============================================================================
# Transactional Email Infrastructure (Phase 9 Stage 3)
# ==============================================================================
# Provider selection: 'mock' | 'brevo' (Default in dev/test: 'mock'. In production: 'brevo' is required; 'mock' is rejected)
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=orders@shopsphere.in
EMAIL_FROM_NAME=ShopSphere
EMAIL_SUPPORT_ADDRESS=support@shopsphere.in
# Optional configured recipient for admin operational alert notifications
ADMIN_NOTIFICATION_EMAIL=admin@shopsphere.in

# Brevo Configuration (Required when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=your_brevo_api_key_placeholder

# Dedicated Secret for Encrypting In-Flight Sensitive Email Tokens (AES-256-GCM)
# In production: Minimum 32 characters required; dev/placeholder values are rejected.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_TOKEN_SECRET=your_32_character_email_token_secret_key_here

# Background Outbox Polling Worker Toggle (true | false, default: true)
EMAIL_WORKER_ENABLED=true

# Outbox Worker & Retry Configuration
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_DELAY_MS=1000
EMAIL_POLL_INTERVAL_MS=10000
EMAIL_BATCH_SIZE=5
EMAIL_PROCESSING_LEASE_MS=300000

